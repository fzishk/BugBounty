# Copy to .env.local to override. All variables are optional.

# Base URL for REST calls. Requests go to <origin>/api/* by default.
VITE_API_BASE_URL=/api/

# WebSocket endpoint for live stock updates.
VITE_LIVE_STOCK_URL=wss://live.bugbazaar.mock/stock

# Run the in-browser mock backend (MSW). Set to "false" to hit a real API.
VITE_ENABLE_MOCKS=true

# Build-time only: the public path the app is served from (used for GitHub Pages).
# VITE_BASE=/BugBounty/
